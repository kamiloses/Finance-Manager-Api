{
  "info": {
    "name": "Finance Manager API",
    "_postman_id": "9f3d8b6a-5f77-4e4b-9f8f-2a4f5a7a1111",
    "description": "Postman collection for testing Finance Manager API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accountId",
      "value": "1"
    },
    {
      "key": "transactionId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Get All Accounts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "Create Account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Main Account\"\n}"
            },
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "Get Account By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          }
        },
        {
          "name": "Delete Account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Get Transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "transactions"
              ]
            }
          }
        },
        {
          "name": "Get Transactions Filtered",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?from=2025-01-01T00:00:00&to=2026-12-31T23:59:59&category=Food",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "accounts",
                "{{accountId}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "2025-01-01T00:00:00"
                },
                {
                  "key": "to",
                  "value": "2026-12-31T23:59:59"
                },
                {
                  "key": "category",
                  "value": "Food"
                }
              ]
            }
          }
        },
        {
          "name": "Create Income Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000.0,\n  \"type\": \"INCOME\",\n  \"category\": \"Salary\",\n  \"description\": \"Monthly salary\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Create Expense Transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 120.5,\n  \"type\": \"EXPENSE\",\n  \"category\": \"Food\",\n  \"description\": \"Lunch\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Delete Transaction",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions/{{transactionId}}"
          }
        },
        {
          "name": "Export Transactions CSV",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions/export"
          }
        }
      ]
    },
    {
      "name": "Summary",
      "item": [
        {
          "name": "Get Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/{{accountId}}/summary"
          }
        }
      ]
    },
    {
      "name": "Validation & Errors",
      "item": [
        {
          "name": "Create Account - Blank Name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\"\n}"
            },
            "url": "{{baseUrl}}/accounts"
          }
        },
        {
          "name": "Create Transaction - Invalid Amount",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": -10,\n  \"type\": \"EXPENSE\",\n  \"category\": \"Food\",\n  \"description\": \"Invalid amount\"\n}"
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "Get Missing Account",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/accounts/999999"
          }
        }
      ]
    }
  ]
}